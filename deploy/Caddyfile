# Local HTTPS for Tresor (compose profile "https").
# All encryption runs in the browser, which browsers only allow in a secure context
# (HTTPS or localhost). Caddy issues certificates from its own local CA – no internet access needed.
#
# Avoid the browser warning by trusting the CA once on your devices:
#   docker compose cp https:/data/caddy/pki/authorities/local/root.crt ./tresor-root.crt
{
	local_certs
	skip_install_trust
}

{$TRESOR_HOSTNAME}:8443 {
	encode zstd gzip
	reverse_proxy app:8080
}
