# ──────────────────────────────────────────────────────────────────────────────
# Tresor configuration
#   1. Copy this file:            cp .env.example .env
#   2. Fill in POSTGRES_PASSWORD and VAULT_MASTER_KEY – create each value with:
#                                 openssl rand -hex 32
#   3. Bundled HTTPS: set TRESOR_HOSTNAME and TRUST_PROXY=true (see below).
# Everything else has sensible defaults. Full reference: docs/configuration.md
# ──────────────────────────────────────────────────────────────────────────────

# Password of the internal PostgreSQL user (never exposed outside the stack).
POSTGRES_PASSWORD=

# Master key for the encryption key hierarchy (≥ 32 characters).
# BACK IT UP! Without it, no data in the database can ever be decrypted again.
VAULT_MASTER_KEY=

# Optional parts of the stack, all started by `docker compose up -d` (comma-separated):
#   https     bundled HTTPS via Caddy (set TRESOR_HOSTNAME below) – leave empty with your own reverse proxy
#   backup    nightly database dumps
#   offsite   copies of the dumps via rclone (together with backup)
# Example: COMPOSE_PROFILES=https,backup
COMPOSE_PROFILES=https

# Published port and bind address of the web app (plain HTTP – put HTTPS in front of it, see below).
TRESOR_PORT=8080
TRESOR_BIND=0.0.0.0

# Bundled HTTPS (profile `https`): IP address or host name the browsers use.
# Passkeys additionally need a host name (not an IP), e.g. tresor.home via your router's DNS.
# With the profile enabled, also set TRUST_PROXY=true (and TRESOR_BIND=127.0.0.1 to hide plain HTTP).
# TRESOR_HOSTNAME=192.168.178.20
# TRESOR_HTTPS_PORT=8443

# Image to run. By default the image is built locally from this repository.
# To use a published image instead:
# TRESOR_IMAGE=ghcr.io/leifistlive/tresor:1.0.0
# TRESOR_PULL_POLICY=missing

# Secure cookies: auto (= when the request arrived via HTTPS), true, false.
COOKIE_SECURE=auto
# Set to true (or the proxy's IP/CIDR) when Tresor runs behind a reverse proxy.
TRUST_PROXY=false
# Send Strict-Transport-Security – only enable when Tresor is always served via HTTPS.
ENABLE_HSTS=false

# Sessions: absolute lifetime and server-side idle timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Housekeeping (0 disables automatic deletion).
TRASH_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Argon2id cost for new passwords. It runs in the browser; the server refuses weaker settings.
# Browsers refuse anything below 19456 KiB / 2 passes. Lower ARGON2_MEMORY_KIB only for very old phones.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3

# Failed sign-in attempts per IP within 5 minutes.
LOGIN_RATE_LIMIT=10

# Upload limits (MB) for attachments and backup imports.
ATTACHMENT_MAX_MB=25
IMPORT_MAX_MB=200

# Passkeys: only needed when the browser reaches Tresor under another host name than the server sees
# (e.g. behind some proxies). Example: WEBAUTHN_RP_ID=tresor.example.home  WEBAUTHN_ORIGIN=https://tresor.example.home
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# Notifications may be sent to loopback/private addresses (local ntfy/Gotify). Link-local
# addresses such as 169.254.169.254 are always refused. Set to false if users are not fully trusted.
NOTIFY_ALLOW_PRIVATE=true

LOG_LEVEL=info

# Optional `backup` profile (add it to COMPOSE_PROFILES)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# TRESOR_BACKUP_PATH=./backups
# TRESOR_DB_PATH=/mnt/user/appdata/tresor/postgres

# Optional `offsite` profile (add it to COMPOSE_PROFILES together with backup):
# copy dumps to an rclone remote (configure it in ./rclone/rclone.conf)
# RCLONE_REMOTE=b2crypt:tresor
# OFFSITE_INTERVAL_HOURS=24
# OFFSITE_KEEP_DAYS=60
