# Fill in, then start with: docker compose up -d
# Secrets: openssl rand -hex 32 – keep a copy of VAULT_MASTER_KEY, without it all data is lost.
POSTGRES_PASSWORD=
VAULT_MASTER_KEY=

# IP or host name of the server → https://<TRESOR_HOSTNAME>:8443
TRESOR_HOSTNAME=

# Bundled HTTPS. Own reverse proxy or more settings: see docs/installation.md and docs/configuration.md
COMPOSE_PROFILES=https
TRUST_PROXY=true
TRESOR_BIND=127.0.0.1
